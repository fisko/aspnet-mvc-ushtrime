@* _Layout = "korniza" e përbashkët e çdo faqeje (menyja, footer-i).
   Çdo View futet te @RenderBody(). Caktohet te Views/_ViewStart.cshtml. *@
@* @inject merr një shërbim nga DI direkt në View. *@
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/University.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">University</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Ballina</a>
                        </li>
                        @* asp-controller/asp-action = Tag Helper: gjeneron href="/Courses" sipas rrugëve *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Courses" asp-action="Index">Kurset</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Students" asp-action="Index">Studentët</a>
                        </li>
                        @* Scalar ekziston vetëm në Development (shih Program.cs) *@
                        @if (Env.IsDevelopment())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/scalar/v1">API</a>
                            </li>
                        }
                    </ul>
                    @* Partial View: Hyr/Regjistrohu ose emri i përdoruesit + Dil *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* Këtu futet përmbajtja e View-it aktual *@
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - University - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privatësia</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* View-t mund të shtojnë skripte këtu me @section Scripts { ... } *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
